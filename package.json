{
  "name": "marktwin",
  "version": "1.0.0",
  "private": true,
  "description": "Private, self-hostable collaborative Markdown, Canvas and drawing workspaces backed by GitHub.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "packageManager": "npm@10.9.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marktwin-com/marktwin.git"
  },
  "bugs": {
    "url": "https://github.com/Marktwin-com/marktwin/issues"
  },
  "homepage": "https://marktwin.com",
  "keywords": [
    "markdown",
    "notes",
    "collaboration",
    "github",
    "webrtc",
    "yjs",
    "self-hosted",
    "privacy"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && node scripts/prune-stale-client-assets.mjs && esbuild server/index.ts --platform=node --packages=external --external:./vite.js --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "npm run test:unit && npm run test:vitest && npm run test:smoke",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:smoke": "node --test tests/browser-smoke.test.mjs",
    "check": "tsc",
    "verify": "npm test && npm run check && npm run build && npm run bundle:check && npm run test:production",
    "test:vitest": "vitest run",
    "bundle:check": "node scripts/check-client-bundle.mjs",
    "test:production": "node --test tests/production-smoke.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.60.5",
    "@uiw/react-codemirror": "^4.25.10",
    "@xyflow/react": "^12.11.3",
    "aes-js": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.2.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "highlight.js": "11.11.1",
    "intl-messageformat": "^11.2.13",
    "js-sha256": "^0.11.1",
    "katex": "0.19.0",
    "lucide-react": "^0.453.0",
    "marked": "^15.0.12",
    "mermaid": "11.17.2",
    "nanoid": "^5.1.16",
    "node-diff3": "3.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.9",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.3.5",
    "ws": "^8.21.3",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.7",
    "yaml": "^2.9.0",
    "yjs": "^13.6.27",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/aes-js": "^3.1.4",
    "@types/express": "4.17.21",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "puppeteer": "^25.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "katex": "$katex",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    },
    "nanoid@<4": "3.3.20",
    "nanoid@>=4 <5": "5.1.16",
    "sass": "1.105.1"
  }
}
