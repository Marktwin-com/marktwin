# Marktwin runs with zero configuration: there is no database and no
# accounts. You paste your GitHub token directly in the app, and it never
# touches the server. Everything below is optional.

# Port the Express server listens on. Defaults to 5001.
PORT=

# Absolute public URL for this deployment, used by server-generated assets such
# as the PDF watermark. Example: https://notes.example.com
PUBLIC_BASE_URL=

# Optional client-side API base URL for split frontend/backend deployments.
# Leave empty for the normal same-origin setup.
VITE_API_BASE_URL=

# Vite dev server HMR host override, useful behind some reverse proxies/containers.
HMR_HOST=

# Enables GitHub OAuth (PKCE) as an alternative to pasting a personal access token.
# Register an OAuth App at https://github.com/settings/developers and set its
# Authorization callback URL to <your-app-url>/github/callback.
VITE_GITHUB_OAUTH_CLIENT_ID=

# Optional WebRTC ICE server overrides for the peer-to-peer collaboration feature.
# Defaults to public STUN servers if unset.
VITE_STUN_URLS=
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_WEBRTC_ICE_SERVERS=
